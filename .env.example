# Plantilla de variables de entorno del staging (Tabla 13 de seguridad:
# "Secretos en el repositorio" y "Contenedores de staging").
#
# NO pongas valores reales aquí. Genera tu .env con:
#     bash scripts/generar-env.sh
# El script rellena las contraseñas con valores aleatorios y no los muestra.
# Guarda una copia de tu .env en el gestor de contraseñas
# (Tabla 11 de recuperación: "Claves y accesos de recuperación").
# Para rotar una contraseña de la base hay que recrear el volumen
# (docker compose down -v), lo que borra los datos: hazlo solo tras un respaldo.

# --- Aplicación ---
# Entorno de CodeIgniter: development | testing | production (index.php:56).
CI_ENV=development
# Puerto del host (solo 127.0.0.1). Si no es 80, base_url debe cambiar (paso 1.2).
APP_PORT=80
# uid/gid del usuario del host, para que Apache escriba en el bind mount (id -u / id -g).
HOST_UID=1000
HOST_GID=1000

# --- Base de datos ---
# Nombre de la base (Tabla 2: base "stock").
DB_NAME=stock
# Usuario de la aplicación: solo tiene permisos sobre DB_NAME (mínimo privilegio, L2-6).
DB_USER=stock_app
# Contraseña del usuario de la aplicación. Generada; distinta de producción.
DB_PASS=cambiar-esto
# Contraseña de root de MySQL. Generada; la aplicación nunca la usa.
DB_ROOT_PASS=cambiar-esto

# --- Claves y URL de la aplicación ---
# Clave de cifrado de CodeIgniter (config.php:328). Generada con: openssl rand -hex 16
# La clave anterior era pública en el historial de git y se rotó (paso 1.2).
ENCRYPTION_KEY=cambiar-esto
# URL base (config.php:26). Vacía = http://localhost/InventorySystem/.
# Cámbiala si APP_PORT no es 80, por ejemplo http://localhost:8080/InventorySystem/
APP_BASE_URL=
