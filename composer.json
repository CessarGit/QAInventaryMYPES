{
    "description": "The CodeIgniter framework",
    "name": "codeigniter/framework",
    "type": "project",
    "homepage": "https://codeigniter.com",
    "license": "MIT",
    "support": {
        "forum": "http://forum.codeigniter.com/",
        "wiki": "https://github.com/bcit-ci/CodeIgniter/wiki",
        "slack": "https://codeigniterchat.slack.com",
        "source": "https://github.com/bcit-ci/CodeIgniter"
    },
    "require": {
        "php": ">=5.3.7"
    },
    "suggest": {
        "paragonie/random_compat": "Provides better randomness in PHP 5.x"
    },
    "require-dev": {
        "mikey179/vfsstream": "1.6.*",
        "phpunit/phpunit": "^9.6",
        "kenjis/ci-phpunit-test": "^0.6.2"
    },
    "scripts": {
        "estatico": "php scripts/analisis_estatico.php",
        "test": "phpunit",
        "test:fase2": "phpunit --exclude-group fase4",
        "semaforo": [
            "@estatico",
            "phpunit || true",
            "php scripts/semaforo.php"
        ],
        "metricas": "php scripts/metricas.php",
        "auditoria": "php scripts/auditoria.php"
    },
    "config": {
        "platform": {
            "php": "7.4.33"
        }
    }
}
