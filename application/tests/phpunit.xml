<?xml version="1.0" encoding="UTF-8"?>
<!-- Suite de la iteración 1 (subpaso 5.2). Base: stock_test (regla 14).
     Ejecutar desde application/tests (Bootstrap.php cambia a este directorio).
     Cobertura limitada a Orders y Products: umbral del 60 % (Tabla 13 de PHVA). -->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/9.3/phpunit.xsd"
		 bootstrap="./Bootstrap.php"
		 backupGlobals="true"
		 colors="true">
	<testsuites>
		<testsuite name="Iteracion 1">
			<directory suffix="_test.php">./</directory>
			<exclude>./_ci_phpunit_test/</exclude>
		</testsuite>
	</testsuites>
	<coverage processUncoveredFiles="true">
		<include>
			<file>../controllers/Orders.php</file>
			<file>../controllers/Products.php</file>
			<file>../models/Model_orders.php</file>
			<file>../models/Model_products.php</file>
		</include>
	</coverage>
</phpunit>
